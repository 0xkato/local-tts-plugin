{
  "manifest_version": 3,
  "name": "Local TTS",
  "version": "0.2.1",
  "description": "Highlight text on any page and hear it read by the neural voices on your own computer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["nativeMessaging", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["page.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Local TTS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Read the selected text aloud"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume reading"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "local-tts@local-tts-plugin",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
